# Environment variables configuration for REMAININGCONNECTIONS

# Application Settings
APP_NAME=REMAININGCONNECTIONS
DEBUG=false
LOG_LEVEL=INFO
DATA_DIR=./data
OUTPUT_DIR=./output

# Network Settings
NETWORK_TIMEOUT=10.0
NETWORK_CONCURRENCY=5
NETWORK_PROXY=

# GitHub API Settings
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=B3B3097
GITHUB_REPO=REMAININGCONNECTIONS
GITHUB_MAX_REPOS_SEARCH=50

# Proxy Checker Settings
CHECKER_ENABLE_XRAY=false
CHECKER_ENABLE_MTPROTO=true
CHECKER_TIMEOUT=8.0
CHECKER_CONCURRENCY=30

# Crawler Settings
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=100
CRAWLER_DELAY_MIN=0.5
CRAWLER_DELAY_MAX=1.5

# Dashboard/API Server
API_HOST=0.0.0.0
API_PORT=8080